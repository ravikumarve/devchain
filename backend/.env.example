# ══════════════════════════════════════════════════════════════
# DevChain Backend — Environment Variables
# Copy to `.env` (cp backend/.env.example backend/.env) and adjust.
#
# TWO MODES — everything is driven by these variables:
#
#   LOCAL MODE (default, zero external dependencies):
#     DATABASE_URL=file:./dev.db        → SQLite
#     STORAGE_PROVIDER=local            → local disk (backend/uploads/)
#     EMAIL_PROVIDER=console            → emails logged, not sent
#     (leave SUPABASE_* / SMTP_* empty) → auth falls back to local JWT+bcrypt
#
#   CLOUD MODE (production, Supabase + Vercel + Render):
#     DATABASE_URL=postgresql://...     → Supabase pooler
#     STORAGE_PROVIDER=supabase         → Supabase Storage
#     EMAIL_PROVIDER=smtp               → real SMTP
#     SUPABASE_URL / SUPABASE_SERVICE_KEY → cloud auth + storage
# ══════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────
# Local:  file:./dev.db
# Cloud:  postgresql://USER:PASS@HOST:5432/postgres?sslmode=require
DATABASE_URL=file:./dev.db

# ── Auth (JWT) ────────────────────────────────────────────
# IMPORTANT: use a random string of at least 32 chars
JWT_SECRET=change-me-to-a-random-32-char-secret
JWT_REFRESH_SECRET=change-me-to-another-random-32-char-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Mode switches ─────────────────────────────────────────
# Storage backend: local (disk) | supabase (cloud)
STORAGE_PROVIDER=local
# Email backend: console (log) | smtp (send)
EMAIL_PROVIDER=console
# Server
NODE_ENV=development
PORT=10000
FRONTEND_URL=http://localhost:5173

# ── Optional: cloud mode (Supabase) ───────────────────────
# Required only when STORAGE_PROVIDER=supabase or NODE_ENV=production
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-key
# Supabase Storage bucket name (defaults to devchain-files)
# SUPABASE_STORAGE_BUCKET=devchain-files

# ── Optional: Stripe (payments) ───────────────────────────
# Works in test mode without live keys. Add your test keys to try the flow.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Optional: SMTP (used when EMAIL_PROVIDER=smtp) ────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password

# ── Optional: ownership hash secret (purchase verification) ──
# OWNERSHIP_HASH_SECRET=change-me-too
